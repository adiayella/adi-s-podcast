# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
YOUTUBE_API_KEY=your-youtube-data-api-key
GEMINI_API_KEY=your-gemini-api-key
RESEND_API_KEY=your-resend-api-key
BRIEF_TO_EMAIL=aditya@example.com
CRON_SECRET=long-random-string

# Password for the admin login (managing podcasts, generating/sending briefs)
ADMIN_PASSWORD=choose-a-strong-password
# Optional: override the Gemini model
# GEMINI_MODEL=gemini-3.5-flash
# Sender shown on briefs (Resend test mode: onboarding@resend.dev)
RESEND_FROM=Podcast Radar <onboarding@resend.dev>
