# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
YOUTUBE_API_KEY=your-youtube-data-api-key
GEMINI_API_KEY=your-gemini-api-key
RESEND_API_KEY=your-resend-api-key
BRIEF_TO_EMAIL=aditya@example.com
CRON_SECRET=long-random-string

# Password for the admin login (managing podcasts, generating/sending briefs)
ADMIN_PASSWORD=choose-a-strong-password
# Optional: override the Gemini model
# GEMINI_MODEL=gemini-3.5-flash
# Sender shown on briefs (Resend test mode: onboarding@resend.dev)
RESEND_FROM=Podcast Radar <onboarding@resend.dev>

# Spotify Web API (app-only, no user login): exact episode links and the sector trend scan. Optional.
# Create an app at developer.spotify.com (Web API). Spotify data is never sent to Gemini.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Tavily web search (search page only, raw results; Tavily's own AI answer is never used). Optional.
TAVILY_API_KEY=tvly-your-tavily-key
